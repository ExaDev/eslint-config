save-exact=true

# npm's own minimum-release-age gate (npm >=11.10.0) has no notion of pnpm-workspace.yaml, so the same first-party exclusion needs its own entry here too, kept in sync with minimumReleaseAgeExclude in pnpm-workspace.yaml. pnpm >=11 ignores non-auth/registry settings in this file, so this line is inert (not an error) under pnpm 11/12, where pnpm-workspace.yaml is authoritative; pnpm 10.16-10.x reads it from here directly.
min-release-age-exclude[]=eslint-plugin-json-canonical

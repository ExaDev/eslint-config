{
  "name": "@exadev/eslint-config",
  "version": "2.10.2",
  "description": "Shared custom ESLint rules and plugin for ExaDev projects",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/eslint-config.git"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": "^16.3.2",
    "eslint": ">=10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": ">=4.8.4",
    "typescript-eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.9.2",
    "@typescript-eslint/rule-tester": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.8",
    "tsdown": "^0.22.13",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "turbo run _build",
    "_build": "tsdown",
    "lint": "turbo run _lint",
    "_lint": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "turbo run _typecheck",
    "_typecheck": "tsc -p tsconfig.json",
    "test": "turbo run _test",
    "_test": "vitest run",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && tsdown && publint && attw --pack",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/utils": "^8.67.0",
    "ts-api-utils": "^2.5.0"
  }
}
